# frontend/Dockerfile
FROM node:20-alpine AS build
WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .
# อ่านค่า (ถ้ามี) ตอน build เพื่อ generate หน้า SSR/static ที่อ้างอิง ENV
ARG NUXT_PUBLIC_API_BASE
ENV NUXT_PUBLIC_API_BASE=${NUXT_PUBLIC_API_BASE}

RUN npm run build

FROM node:20-alpine
WORKDIR /app
COPY --from=build /app/.output ./.output

ENV NITRO_PORT=3000
EXPOSE 3000

CMD ["node", ".output/server/index.mjs"]
